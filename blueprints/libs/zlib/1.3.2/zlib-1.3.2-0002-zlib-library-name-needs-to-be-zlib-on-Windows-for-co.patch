From 68768eb1adcf3a17193daff2bd5d1cf2c3d51d00 Mon Sep 17 00:00:00 2001
From: Matthieu Gallien <matthieu.gallien@nextcloud.com>
Date: Fri, 24 Apr 2026 17:25:49 +0200
Subject: [PATCH 2/4] zlib library name needs to be zlib on Windows for
 compatibility

Signed-off-by: Matthieu Gallien <matthieu.gallien@nextcloud.com>
---
 CMakeLists.txt  | 9 ++++++++-
 zlib.pc.cmakein | 2 +-
 2 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index e103c40..afae772 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -112,6 +112,13 @@ check_c_source_compiles(
 
 unset(CMAKE_COMPILE_FLAGS)
 set(ZLIB_PC ${zlib_BINARY_DIR}/zlib.pc)
+
+if(WIN32)
+    set(ZLIB_NAME zlib)
+else()
+    set(ZLIB_NAME z)
+endif()
+
 configure_file(${zlib_SOURCE_DIR}/zlib.pc.cmakein ${ZLIB_PC} @ONLY)
 configure_file(${zlib_BINARY_DIR}/zconf.h.cmakein ${zlib_BINARY_DIR}/zconf.h)
 
@@ -183,7 +190,7 @@ if(ZLIB_BUILD_SHARED)
         zlib
         PROPERTIES DEFINE_SYMBOL ZLIB_DLL
                    EXPORT_NAME ZLIB
-                   OUTPUT_NAME z)
+                   OUTPUT_NAME ${ZLIB_NAME})
     if(UNIX
         AND NOT APPLE
         AND NOT (CMAKE_SYSTEM_NAME STREQUAL AIX)
diff --git a/zlib.pc.cmakein b/zlib.pc.cmakein
index a392727..514f08b 100644
--- a/zlib.pc.cmakein
+++ b/zlib.pc.cmakein
@@ -10,5 +10,5 @@ Version: @zlib_VERSION@
 License: Zlib
 
 Requires:
-Libs: -L${libdir} -L${sharedlibdir} -lz
+Libs: -L${libdir} -L${sharedlibdir} -l@ZLIB_NAME@
 Cflags: -I${includedir}
-- 
